clear all;
clc;
set(groot, 'defaultFigureColor', 'w');
set(groot, 'defaultAxesColor', 'w');
%% Zad2

N_samples = 1000; 
u = randn(N_samples, 1); 

a_true = [0.6, -0.2]; 
b_true = [0.5, 0.3]; 

c_true = 0.8; 
d_true = 0.1;

p_true = [a_true, b_true, c_true, d_true];


z = zeros(N_samples, 1);
for k = 3:N_samples
    z(k) = b_true(1)*u(k) + b_true(2)*u(k-1) - a_true(1)*z(k-1) - a_true(2)*z(k-2);
end


y = c_true*z + d_true*(z.^3);


figure;
subplot(2,1,1);
plot(u);
title('Sygnał wejściowy u');
xlabel('Numer próbki')
ylabel('y')
grid on;

subplot(2,1,2);
plot(y); 
title('Sygnał wyjściowy obiektu Wienera y');
xlabel('Numer próbki');
ylabel('u')
grid on;

%% Zad3

K = 1.5;        
T = 1.0;        
tau = 0.5;     

f_bw = 1 / (2 * pi * T); 
fs = 4 * f_bw;           
Tp = 1 / fs;             

N_samples = 5000;
u = randn(N_samples, 1); 
t = (0:N_samples-1)' * Tp;

s = tf('s');
G_cont = K / (T*s + 1);
G_cont.InputDelay = tau;

z = lsim(G_cont, u, t);
c = 0.6;
d = 0.04;

y = c*z + d*(z.^3);

figure;
subplot(2,1,1);
plot(t, u);
title('Wejście u(t)');
xlabel('Czas, s');
ylabel('u(t)')
grid on;

subplot(2,1,2);
plot(t, y);
title('Próbkowane wyjście y(t) obiektu ciągłego');
xlabel('Czas, s');
ylabel('y(t)');
grid on;


%%% Zad5

%% poszukiwanie losowe

clear all;


N_samples = 1000; 
u = randn(N_samples, 1);
a_true = [0.6, -0.2]; b_true = [0.5, 0.3]; c_true = 0.8; d_true = 0.1;
p_true = [a_true, b_true, c_true, d_true];

u_step = ones(100, 1);
y_step_true = symuluj_model_wew(p_true, u_step);
y = symuluj_model_wew(p_true, u) + 0.01 * randn(N_samples, 1);

ileLokalnie = 100;
iteracje_test = [50, 200, 1000]; 
kolory = {'r--', 'g--', 'b--'};

figure('Color', 'w'); 
plot(y_step_true, 'k', 'LineWidth', 2.5); hold on;
legend_entries = {'Obiekt rzeczywisty'};

for idx = 1:length(iteracje_test)
    N_iter = iteracje_test(idx);

    
    best_z_10_prob = inf;
    p_best_z_10_prob = zeros(1,6);
    
    for p = 1:10 
        [p_tmp, n_tmp] = puszukiwaniaLosowe(u, y, 2, N_iter, 0.2, ileLokalnie);
        if n_tmp < best_z_10_prob
            best_z_10_prob = n_tmp;
            p_best_z_10_prob = p_tmp;
        end
    end

    
    y_est = symuluj_model_wew(p_best_z_10_prob, u_step);
    plot(y_est, kolory{idx});
    mse_val = best_z_10_prob / N_samples;
    legend_entries{end+1} = sprintf('N=%d (MSE: %.2e)', N_iter, mse_val);
end

legend(legend_entries, 'Location', 'best');
xlabel('Próbka'); ylabel('y'); grid on;

%% ls curve
clear all;

N_samples = 1000; 
u = randn(N_samples, 1);
a_true = [0.6, -0.2]; b_true = [0.5, 0.3]; c_true = 0.8; d_true = 0.1;
p_true = [a_true, b_true, c_true, d_true];

y = symuluj_model(p_true, u);

ileLokalnie = 100;

iteracje_test = [20, 100, 500]; 
kolory = {'r--', 'g--', 'm--'}; 
liczba_prob = 5;             
zakres = 2; mi = 0.1;
lb = [-2.9, -1.9, -10, -10, -10, -10]; 
ub = [ 2.9,  1.9,  10  10,  10,  10];

figure('Color', 'w', 'Name', 'Porównanie zbieżności modeli');
u_step = ones(100, 1);
y_step_true = symuluj_model(p_true, u_step);

plot(y_step_true, 'k', 'LineWidth', 3); 
hold on;
legend_entries = {'Obiekt rzeczywisty'};


for idx = 1:length(iteracje_test)
    N_iter = iteracje_test(idx);
    najlepszy_lokalnie_norm = inf;
    najlepszy_lokalnie_params = [];
       
    for p = 1:liczba_prob
      
       [p_est, n_norm] = poszukiwaniaLosoweLscurve(u, y, zakres, N_iter, 0.5, lb, ub);
        if n_norm < najlepszy_lokalnie_norm
            najlepszy_lokalnie_norm = n_norm;
            najlepszy_lokalnie_params = p_est;
        end 
    end
    
    mse_val = najlepszy_lokalnie_norm / length(y);
   
    y_step_est = symuluj_model(najlepszy_lokalnie_params, u_step);
    
    plot(y_step_est, kolory{idx});

    legend_entries{end+1} = sprintf('N=%d (MSE: %.4e)', N_iter, mse_val);
end

xlabel('Próbka');
ylabel('Amplituda y');
legend(legend_entries, 'Location', 'best');
grid on;
set(gca, 'FontSize', 12);

%% Zad6 


%%% funkcje 
function y_mod = symuluj_model(p, u)
    z = zeros(size(u));
    for k = 3:length(u)
        z(k) = p(3)*u(k) + p(4)*u(k-1) - p(1)*z(k-1) - p(2)*z(k-2);
        if abs(z(k)) > 1e4 
            y_mod = ones(size(u)) * 1e6; return;
        end
    end
    y_mod = p(5)*z + p(6)*(z.^3);
end

function y_mod = symuluj_model_wew(p, u)
    z = zeros(size(u));
    for k = 3:length(u)
        z(k) = p(3)*u(k) + p(4)*u(k-1) - p(1)*z(k-1) - p(2)*z(k-2);
        if abs(z(k)) > 1e4, y_mod = zeros(size(u))+1e6; return; end
    end
    y_mod = p(5)*z + p(6)*(z.^3);
end
